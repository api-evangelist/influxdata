{
  "opencollection": "1.0.0",
  "info": {
    "name": "InfluxDB Cloud API Service Authorizations (API tokens) Authorizations (API tokens) Ready API",
    "version": "2.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ready",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the readiness of an instance at startup",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/ready",
            "headers": [
              {
                "name": "Zap-Trace-Span",
                "value": "[object Object]"
              }
            ]
          },
          "docs": "Get the readiness of an instance at startup"
        }
      ]
    }
  ],
  "bundled": true
}